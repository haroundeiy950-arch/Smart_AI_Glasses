APP_MODE=development
DB_ENGINE=sqlite
SQLITE_PATH=data/smart_ai_glasses.db

# MySQL optional
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_ai_glasses

CAMERA_INDEX=0
CAMERA_CANDIDATES=0,1,2,3
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_BACKEND=auto
FACE_SAMPLE_COUNT=30
FACE_UNKNOWN_THRESHOLD=75
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.45

# Example Windows path
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=ara+eng+fra

DEFAULT_UI_LANGUAGE=ar
DEFAULT_TARGET_LANGUAGE=rw

AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
